rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION VALIDATION
    // =========================================================================

    // Checks if the user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Tenant ID extracted from JWT Custom Claims
    function getTenantId() {
      return request.auth.token.tenantId;
    }

    // Role extracted from JWT Custom Claims: 'OWNER', 'MANAGER', 'SALES', 'ACCOUNTANT'
    function getRole() {
      return request.auth.token.role;
    }

    // Checks if the user belongs to the specified tenant ID
    function isTenantUser(tenantId) {
      return isAuthenticated() && getTenantId() == tenantId;
    }

    // Validates that an existing resource belongs to the user's tenant
    function isSameTenantResource() {
      return isAuthenticated() && resource.data.tenantId == getTenantId();
    }

    // Validates that an incoming (create/update) resource belongs to the user's tenant
    function isSameTenantIncoming() {
      return isAuthenticated() && request.resource.data.tenantId == getTenantId();
    }

    // Role verification helpers
    function isOwner() {
      return isAuthenticated() && getRole() == 'OWNER';
    }

    function isManager() {
      return isAuthenticated() && getRole() == 'MANAGER';
    }

    function isSales() {
      return isAuthenticated() && getRole() == 'SALES';
    }

    function isAccountant() {
      return isAuthenticated() && getRole() == 'ACCOUNTANT';
    }

    // =========================================================================
    // 1. TENANTS & CONFIGURATION
    // =========================================================================

    match /tenants/{tenantId} {
      // Any authenticated tenant user can read their shop profile
      allow read: if isTenantUser(tenantId);
      // Only the OWNER can modify shop settings, BIN number, or profile details
      allow write: if isTenantUser(tenantId) && isOwner();
    }

    // =========================================================================
    // 2. USER PROFILES & ACCESS CONTROL
    // =========================================================================

    match /users/{userId} {
      // Owners & Managers can view all staff; users can read their own profile
      allow read: if isSameTenantResource() && (isOwner() || isManager() || request.auth.uid == userId);
      // Only the OWNER can create, modify, or disable staff accounts
      allow write: if isSameTenantIncoming() && isOwner();
    }

    // =========================================================================
    // 3. BOOK CATALOG & STOCK LEDGER
    // =========================================================================

    match /books/{bookId} {
      // All authenticated tenant staff need catalog read access for sales, stock & reporting
      allow read: if isSameTenantResource();
      // Only OWNER and MANAGER can add/edit catalog items, prices, and thresholds
      allow write: if isSameTenantIncoming() && (isOwner() || isManager());
    }

    match /stock_ledger/{entryId} {
      // Only OWNER and MANAGER can review the complete stock ledger
      allow read: if isSameTenantResource() && (isOwner() || isManager());
      // SALES, MANAGER, and OWNER can create immutable ledger transactions (sales/returns/purchases)
      allow create: if isSameTenantIncoming() && (isOwner() || isManager() || isSales());
      // Append-only ledger: Updates and deletions are forbidden from client SDKs
      allow update, delete: if false;
    }

    // =========================================================================
    // 4. BILLING & INVOICING (POS)
    // =========================================================================

    match /bills/{billId} {
      // OWNER and MANAGER can read all bills; SALES can only read their own shift bills
      allow read: if isSameTenantResource() && (
        isOwner() || isManager() || (isSales() && resource.data.userId == request.auth.uid)
      );
      // OWNER, MANAGER, and SALES can create bills
      allow create: if isSameTenantIncoming() && (isOwner() || isManager() || isSales());
      // Only OWNER can update/void a bill (ACCOUNTANT & SALES are forbidden from modifying bills)
      allow update, delete: if isSameTenantResource() && isOwner();
    }

    match /bill_lines/{lineId} {
      // OWNER, MANAGER, and SALES can read bill lines for their tenant
      allow read: if isSameTenantResource() && (isOwner() || isManager() || isSales());
      // Lines created alongside bills by OWNER, MANAGER, or SALES
      allow create: if isSameTenantIncoming() && (isOwner() || isManager() || isSales());
      // Only OWNER can modify or delete lines
      allow update, delete: if isSameTenantResource() && isOwner();
    }

    // =========================================================================
    // 5. KHATA (CUSTOMER CREDIT / BOKEYA)
    // =========================================================================

    match /khata_customers/{customerId} {
      // OWNER and MANAGER can read and manage khata customers; SALES cannot read
      allow read: if isSameTenantResource() && (isOwner() || isManager());
      allow write: if isSameTenantIncoming() && (isOwner() || isManager());
    }

    match /khata_entries/{entryId} {
      // OWNER and MANAGER can view dues and credit histories; SALES has NO access
      allow read: if isSameTenantResource() && (isOwner() || isManager());
      // Append-only credit/payment entries can be created by OWNER or MANAGER
      allow create: if isSameTenantIncoming() && (isOwner() || isManager());
      // Financial ledger integrity: No client updates or deletes
      allow update, delete: if false;
    }

    // =========================================================================
    // 6. ACCOUNTING, EXPENSES & CASHBOOK
    // =========================================================================

    match /expenses/{expenseId} {
      // OWNER and ACCOUNTANT have full expense visibility; SALES & MANAGER have NO access
      allow read: if isSameTenantResource() && (isOwner() || isAccountant());
      // Only OWNER and ACCOUNTANT can record or update expenses (MANAGER & SALES write FAILS)
      allow write: if isSameTenantIncoming() && (isOwner() || isAccountant());
    }

    match /cashbook_entries/{entryId} {
      // OWNER and ACCOUNTANT can view cash/bKash/bank ledgers
      allow read: if isSameTenantResource() && (isOwner() || isAccountant());
      // Append-only cashbook entry creation by OWNER and ACCOUNTANT
      allow create: if isSameTenantIncoming() && (isOwner() || isAccountant());
      // Ledger integrity: No client updates or deletes
      allow update, delete: if false;
    }

    // =========================================================================
    // 7. SUBSCRIPTION, LICENSES & WALLET TRANSACTIONS
    // =========================================================================

    match /license_records/{licenseId} {
      // Only OWNER can read their store's license status; no client writes (server-managed)
      allow read: if isSameTenantResource() && isOwner();
      allow write: if false;
    }

    match /subscription_payments/{paymentId} {
      // OWNER can view their payment history and initiate new subscription payments
      allow read: if isSameTenantResource() && isOwner();
      allow create: if isSameTenantIncoming() && isOwner();
      allow update, delete: if false;
    }

    match /wallet_transactions/{transactionId} {
      // OWNER can view pre-paid wallet balance and transaction records; writes are server-only
      allow read: if isSameTenantResource() && isOwner();
      allow write: if false;
    }

    match /activation_redemptions/{redemptionId} {
      // Secure scratch-card / activation code redemptions are strictly server-side (Cloud Functions)
      allow read, write: if false;
    }

    // =========================================================================
    // 8. AUDIT LOGS
    // =========================================================================

    match /local_audit_logs/{logId} {
      // Immutable audit trail: Only OWNER can inspect logs; client cannot tamper/write directly
      allow read: if isSameTenantResource() && isOwner();
      allow write: if false;
    }
  }
}
